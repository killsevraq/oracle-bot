# Mode du bot : "demo" (paris simulés, 0$) ou "prod" (paris réels via Polymarket CLOB)
MODE=demo

# Montant par pari (USDC virtuel en demo, USDC reel en prod)
BET_AMOUNT=5

# Stop-Loss / Take-Profit (en USDC, 0 = desactive)
STOP_LOSS=0
TAKE_PROFIT=0

# Solde virtuel de depart pour le mode demo
DEMO_STARTING_BALANCE=100

# Marche cible Polymarket (slug ou identifiant). Laisser vide pour auto-detection BTC 5min.
POLYMARKET_MARKET_SLUG=

# Telegram (optionnel : si TELEGRAM_BOT_TOKEN est vide, les notifs sont desactivees)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Production uniquement : cle privee du wallet Polygon contenant des USDC
# NE JAMAIS COMMITER CETTE CLE
POLYMARKET_PRIVATE_KEY=
POLYMARKET_FUNDER_ADDRESS=

# API
API_HOST=0.0.0.0
API_PORT=8000

# Base SQLite
DATABASE_URL=sqlite+aiosqlite:///./data/oracle.db

# Bougie Binance (pour le signal). Binance NE supporte PAS 10m.
# Valides : 1m, 3m, 5m, 15m, 30m, 1h, 2h, 4h, 6h, 8h, 12h, 1d.
# Garde la cohérence avec CANDLE_INTERVAL_SECONDS (300 pour 5m, 60 pour 1m, 900 pour 15m, ...)
BINANCE_WS_URL=wss://stream.binance.com:9443/ws/btcusdt@kline_5m
CANDLE_INTERVAL_SECONDS=300

# Delai de resolution d'un pari (sec). Pour BTC 5min Polymarket, garder 300.
BET_RESOLUTION_SECONDS=300

# Filtres de signal — pour eviter de parier sur du bruit (proche de ce qu'un humain ferait).
# Corps minimum d'une bougie en %. 0.02% ~ 16 USD sur 78kBTC. Monter pour etre plus selectif.
MIN_CANDLE_BODY_PCT=0.02
# Seuil de detection de tendance Binance en %. En dessous => trend FLAT => skip.
BINANCE_TREND_THRESHOLD_PCT=0.02
# Confirmation post-cloture : attendre N sec apres la fermeture et verifier que le prix
# continue dans la direction du signal. 0 = pas de confirmation.
POST_CLOSE_CONFIRMATION_SECONDS=3
